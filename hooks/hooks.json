{
  "description": "Cache Assistant: a band above the prompt (hooks module), plus guards that block the first send once when a large prompt cache has expired or a model/effort switch would bust it, ask before a model switch that forfeits a large warm cache, and warn on resuming a session whose window has expired.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/model_switch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/model_switch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
